### Android ###
# Built application files
*.apk
*.ap_
*.aab
*.aar

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard
proguard/
proguardMapping.txt

# Log files
*.log

# Android Studio / IntelliJ
*.iml
.idea/
.idea/*
!.idea/codeStyles/
!.idea/inspectionProfiles/
navigation/
captures/
.externalNativeBuild
.cxx/

# OS-specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

### Kotlin ###
*.kotlin_module

### Gradle ###
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

### Android Studio Patch ###
/*/build/
/*/local.properties
/*/out
/*/*/build
/*/*/production
*.hprof
output-metadata.json

### Signing ###
*.jks
*.keystore

